# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# Your Google Cloud project, registered for Earth Engine
EE_PROJECT=your-gcp-project-id

# Optional: path to a service account key file, for unattended runs.
# Leave blank to use your personal login instead.
EE_SERVICE_ACCOUNT_KEY=
EE_SERVICE_ACCOUNT_EMAIL=
